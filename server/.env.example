APP_NAME=SupplyLink API
APP_VERSION=0.1.0
NODE_ENV=development
PORT=4000
API_PREFIX=/api
API_VERSION=v1
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
ENABLE_DB_SSL=false
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
DATABASE_URL=your_database_url_here
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SupplyLink
EMAIL_REPLY_TO=
DEMO_SEED_PASSWORD=Password123!
ALLOW_DEMO_SEED_IN_PRODUCTION=false
FILE_UPLOAD_DIR=uploads
FILE_UPLOAD_MAX_BYTES=10485760
ENFORCE_STOCK_AVAILABILITY=false
