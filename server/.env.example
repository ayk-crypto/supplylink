APP_NAME=SupplyLink API
APP_VERSION=0.1.0
NODE_ENV=development
PORT=4000
API_PREFIX=/api
API_VERSION=v1
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
ENABLE_DB_SSL=false
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
DATABASE_URL=your_database_url_here
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/supplylink_test
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=smtp-user
EMAIL_SMTP_PASS=smtp-password
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=SupplyLink
EMAIL_REPLY_TO=support@example.com
DEMO_SEED_PASSWORD=Password123!
ALLOW_DEMO_SEED_IN_PRODUCTION=false
FILE_UPLOAD_DIR=uploads
FILE_UPLOAD_MAX_BYTES=10485760
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
ENFORCE_STOCK_AVAILABILITY=false
