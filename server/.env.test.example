APP_NAME=SupplyLink API
APP_VERSION=0.1.0
NODE_ENV=test
PORT=4001
API_PREFIX=/api
API_VERSION=v1
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=error
ENABLE_DB_SSL=false
JWT_SECRET=change_this_to_a_long_random_test_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=4
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/supplylink_test
DATABASE_URL=
EMAIL_SMTP_HOST=smtp.test.local
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@test.local
EMAIL_FROM_NAME=SupplyLink Test
EMAIL_REPLY_TO=support@test.local
FILE_UPLOAD_DIR=.tmp/test-uploads
FILE_UPLOAD_MAX_BYTES=1048576
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=1000
ENFORCE_STOCK_AVAILABILITY=false
