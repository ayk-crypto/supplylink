APP_NAME=SupplyLink API
APP_VERSION=0.1.0
NODE_ENV=test
PORT=4001
API_PREFIX=/api
API_VERSION=v1
CLIENT_URL=http://localhost:5173
LOG_LEVEL=error
ENABLE_DB_SSL=false
JWT_SECRET=change_this_to_a_long_random_test_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=4
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/supplylink_test
DATABASE_URL=postgres://postgres:postgres@localhost:5432/supplylink_test
FILE_UPLOAD_DIR=.tmp/test-uploads
FILE_UPLOAD_MAX_BYTES=1048576
