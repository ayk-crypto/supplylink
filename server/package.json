{
  "name": "supplylink-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "lint": "eslint .",
    "build": "node -e \"console.log('Server build check passed')\"",
    "test": "node --test \"src/**/*.test.js\"",
    "test:integration": "cross-env NODE_ENV=test node --test \"src/**/*.integration.test.js\"",
    "db:migrate": "cross-env NODE_ENV=development node src/database/scripts/migrate.js",
    "db:seed": "cross-env NODE_ENV=development node src/database/scripts/seed.js",
    "db:bootstrap": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pg": "^8.15.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.10"
  }
}
